{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "renderer/**/*",
    "shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["renderer/*"],
      "@shared/*": ["shared/*"]
    }
  }
}
