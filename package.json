{
  "name": "eda-cleaner",
  "version": "1.0.0",
  "description": "EdaCleaner — PC cleanup and performance optimization for Windows, macOS, and Linux",
  "homepage": "https://edacleaner.com",
  "main": "./out/main/index.js",
  "author": {
    "name": "EDA Cleaner",
    "email": "support@edacleaner.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "build:win": "npm run dist:win && npm run publish:release",
    "build:mac": "npm run dist:mac && npm run publish:release",
    "build:linux": "npm run dist:linux && npm run publish:release",
    "build:all": "npm run dist:all && npm run publish:release",
    "dist:win": "npm run build && electron-builder --win --config build/electron-builder.config.js",
    "dist:mac": "npm run build && electron-builder --mac --config build/electron-builder.config.js",
    "dist:linux": "npm run build && electron-builder --linux --config build/electron-builder.config.js",
    "dist:all": "npm run build && electron-builder -mwl --config build/electron-builder.config.js",
    "publish:release": "node scripts/publish-release.mjs",
    "publish:release:yes": "node scripts/publish-release.mjs --yes"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-query-devtools": "^5.62.8",
    "axios": "^1.7.9",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fdir": "^6.5.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11"
  }
}
