# Environment
NODE_ENV=development

# Single API base URL (main process, renderer, release publisher)
# Local: http://localhost:5000/api/v1
# Production packaged builds: must be https://...
# In GitHub Actions, set repository secret SERVER_API_BASE_URL
SERVER_API_BASE_URL=http://localhost:5000/api/v1

# Optional CI overrides for publish-release.mjs
# RELEASE_VERSION=1.0.1
# RELEASE_TYPE=stable
# RELEASE_NOTES=Bug fixes,Performance improvements
# RELEASE_PUBLISH=true
# PUBLISH_RELEASE=1

# Feature Flags (can be extended)
VITE_ENABLE_ANALYTICS=false
