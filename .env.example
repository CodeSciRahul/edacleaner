# Environment
NODE_ENV=development

# API Configuration (Renderer)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# API Configuration (Electron main — used for S3 presigned uploads)
MAIN_VITE_API_BASE_URL=http://localhost:5000/api/v1

# Release publisher (scripts/publish-release.mjs) — falls back to MAIN_VITE / VITE
# In GitHub Actions, set this as repository secret RELEASE_API_BASE_URL
RELEASE_API_BASE_URL=http://localhost:5000/api/v1

# Optional CI overrides for publish-release.mjs
# RELEASE_VERSION=1.0.1
# RELEASE_TYPE=stable
# RELEASE_NOTES=Bug fixes,Performance improvements
# RELEASE_PUBLISH=true
# PUBLISH_RELEASE=1

# Feature Flags (can be extended)
VITE_ENABLE_ANALYTICS=false
