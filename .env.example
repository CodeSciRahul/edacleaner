# Environment
NODE_ENV=development

# API Configuration (Renderer)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# API Configuration (Electron main — used for S3 presigned uploads)
MAIN_VITE_API_BASE_URL=http://localhost:5000/api/v1

# Release publisher (scripts/publish-release.mjs) — falls back to MAIN_VITE / VITE
RELEASE_API_BASE_URL=http://localhost:5000/api/v1

# Feature Flags (can be extended)
VITE_ENABLE_ANALYTICS=false
